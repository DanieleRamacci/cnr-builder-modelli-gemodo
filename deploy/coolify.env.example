# Variabili Coolify per deploy applicativo GEMODO DEV.
# Sostituire i valori CAMBIA_* prima del deploy.

POSTGRES_DB=gemodo
POSTGRES_USER=gemodo
POSTGRES_PASSWORD=CAMBIA_PASSWORD_POSTGRES_FORTE

# Se la password contiene caratteri speciali URL (@, :, /, #, %, ?), compilare DATABASE_URL
# con la password URL-encoded. In alternativa lasciare questo valore coerente con i tre
# parametri Postgres sopra.
DATABASE_URL=postgresql+psycopg://gemodo:CAMBIA_PASSWORD_POSTGRES_FORTE@postgres:5432/gemodo

KEYCLOAK_ISSUER_URL=https://sso.test.si.cnr.it/auth/realms/cnr
KEYCLOAK_AUDIENCE=gemodo-backend
KEYCLOAK_FRONTEND_CLIENT_ID=gemodo-frontend
GEMODO_ALLOWED_INTERACTIVE_CLIENTS=gemodo-frontend
KEYCLOAK_JWKS_URL=
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
GEMODO_CORS_ALLOWED_ORIGINS=http://localhost:4200,https://geban.test.si.cnr.it

# Deve essere false in Coolify se vuoi testare davvero l'autorizzazione Keycloak.
GEMODO_USE_MOCK_PRINCIPAL=false

# Mappa esplicita tipo documento -> URL discovery, senza catalogo locale di fallback.
# Sostituire l'URL demo con quello concordato con il sistema integrato.
GEMODO_DISCOVERY_ENDPOINTS='{"BANDO_CONCORSO":"https://software.example.org/api/v1/gemodo/discovery"}'
# Prima di upgrade 0009: backup DB. Rollback richiede ripristino del backup.

# Opzionale oggi: il PDF/documentale non e' ancora implementato nella runtime API.
DOCUMENTALE_MOCK_URL=
